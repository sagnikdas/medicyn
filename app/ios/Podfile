# Current iOS plugins require iOS 15.5 (google_mlkit_commons is the floor).
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # flutter_additional_ios_build_settings pins every pod target's deployment
  # target below this Podfile's declared floor (observed: 15.0), which then
  # fails to compile against pods whose own podspec requires 15.5 (e.g.
  # PromisesObjC/PromisesSwift, a GoogleSignIn dependency). Re-assert the
  # floor from line 2 after Flutter's own pass.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end

  # Xcode's implicit-dependency resolution for the workspace sometimes fails
  # to schedule the Pods-Runner aggregate target before linking Runner,
  # producing "Framework 'Pods_Runner' not found". Make the dependency
  # explicit so Runner always builds it first.
  runner_project = installer.aggregate_targets.first.user_project
  runner_target = runner_project.native_targets.find { |t| t.name == 'Runner' }
  pods_project_path = installer.pods_project.path.to_s
  subproject_ref = runner_project.reference_for_path(pods_project_path) ||
    runner_project.main_group.new_reference(pods_project_path)
  pods_runner_target = installer.pods_project.targets.find { |t| t.name == 'Pods-Runner' }
  unless runner_target.dependency_for_target(pods_runner_target)
    runner_target.add_dependency(pods_runner_target)
  end
  runner_project.save

  # google_mlkit_commons vendors MLImage.framework/MLKitCommon.framework etc.
  # as plain fat frameworks whose arm64 slice is device-only (no arm64
  # simulator slice exists upstream). Building for arm64 simulator therefore
  # always fails to link. Force x86_64-only simulator builds (runs under
  # Rosetta) across both the Pods project and the Runner app so their
  # architectures match.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited) arm64'
  end
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited) arm64'
    end
  end
  runner_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited) arm64'
  end
  runner_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = '$(inherited) arm64'
    end
  end
  runner_project.save
end
