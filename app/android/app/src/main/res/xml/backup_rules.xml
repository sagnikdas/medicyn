<?xml version="1.0" encoding="utf-8"?>
<!-- Belt and braces with allowBackup=false: if a future change re-enables
     backup, still keep the session and the medical database off the wire. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
