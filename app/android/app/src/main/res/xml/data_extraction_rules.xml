<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ uses this instead of fullBackupContent. Both cloud backup
     and device-to-device transfer are refused for the same files F-3 and
     F-4 live in: the session blob and the on-device medical database. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
